{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anniv.soorokim.com/contracts/avatar-asset-manifest-v1.schema.json",
  "title": "Avatar Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetSetVersion", "phase", "catalogVersion", "canvas", "layerOrder", "fallback", "parts", "aliases", "pilotCases", "provenance", "review"],
  "properties": {
    "schemaVersion": { "const": "avatar-asset-manifest-v1" },
    "assetSetVersion": { "type": "string", "pattern": "^pixel-layers-v[1-9][0-9]*$" },
    "phase": { "enum": ["pilot", "approved", "retired"] },
    "catalogVersion": { "const": "pixel-parts-v1" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "layerOrder": { "const": ["hairBack", "body", "outfit", "faceFeatures", "hairFront", "item", "accent"] },
    "fallback": { "$ref": "#/$defs/fileAsset" },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "hair", "outfit", "item"],
      "properties": {
        "body": { "$ref": "#/$defs/partMap" },
        "hair": { "$ref": "#/$defs/partMap" },
        "outfit": { "$ref": "#/$defs/partMap" },
        "item": { "$ref": "#/$defs/partMap" }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessory", "developerItem"],
      "properties": {
        "accessory": { "$ref": "#/$defs/aliasMap" },
        "developerItem": { "$ref": "#/$defs/aliasMap" }
      }
    },
    "pilotCases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pilotCase" }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenance" }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recordPath"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date" },
        "recordPath": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 255 },
        "y": { "type": "integer", "minimum": 0, "maximum": 383 },
        "width": { "type": "integer", "minimum": 1, "maximum": 256 },
        "height": { "type": "integer", "minimum": 1, "maximum": 384 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 255 },
        "y": { "type": "integer", "minimum": 0, "maximum": 383 }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "logicalWidth", "logicalHeight", "exportScale", "pixelInterpolation", "safeBounds", "baselineY", "faceSafeArea", "torsoArea", "anchors"],
      "properties": {
        "width": { "const": 256 },
        "height": { "const": 384 },
        "logicalWidth": { "const": 128 },
        "logicalHeight": { "const": 192 },
        "exportScale": { "const": 2 },
        "pixelInterpolation": { "const": "nearest" },
        "safeBounds": { "$ref": "#/$defs/rect" },
        "baselineY": { "type": "integer", "minimum": 1, "maximum": 383 },
        "faceSafeArea": { "$ref": "#/$defs/rect" },
        "torsoArea": { "$ref": "#/$defs/rect" },
        "anchors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/point" },
          "required": ["leftHand", "rightHand", "leftGround", "rightGround"]
        }
      }
    },
    "fileAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "provenanceId"],
      "properties": {
        "path": { "type": "string", "pattern": "^/avatar-parts/v3/.+\\.png$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provenanceId": { "type": "string", "minLength": 1 }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "layers", "contentBounds", "anchor", "provenanceId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["body", "hair", "outfit", "item"] },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hairBack": { "$ref": "#/$defs/fileAsset" },
            "body": { "$ref": "#/$defs/fileAsset" },
            "outfit": { "$ref": "#/$defs/fileAsset" },
            "hairFront": { "$ref": "#/$defs/fileAsset" },
            "item": { "$ref": "#/$defs/fileAsset" }
          }
        },
        "contentBounds": { "oneOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "anchor": { "type": ["string", "null"] },
        "provenanceId": { "type": "string", "minLength": 1 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/visualVariant" }
        }
      }
    },
    "visualVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layers", "contentBounds", "provenanceId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hairBack": { "$ref": "#/$defs/fileAsset" },
            "body": { "$ref": "#/$defs/fileAsset" },
            "outfit": { "$ref": "#/$defs/fileAsset" },
            "hairFront": { "$ref": "#/$defs/fileAsset" },
            "item": { "$ref": "#/$defs/fileAsset" }
          }
        },
        "contentBounds": { "oneOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "provenanceId": { "type": "string", "minLength": 1 }
      }
    },
    "partMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/part" }
    },
    "aliasMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "pilotCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "traits", "developerItem", "expectedItemId", "riskCoverage"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "traits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "hair", "outfit", "accessory", "accent"],
          "properties": {
            "body": { "type": "string" },
            "hair": { "type": "string" },
            "outfit": { "type": "string" },
            "accessory": { "type": "string" },
            "accent": { "type": "string" }
          }
        },
        "developerItem": { "type": "string", "minLength": 1 },
        "expectedItemId": { "type": "string", "minLength": 1 },
        "riskCoverage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceType", "creatorOrTool", "createdAt", "sourceAsset", "modifications", "licenseSpdx", "redistributionAllowed", "noticeFile"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["project-generated", "third-party"] },
        "creatorOrTool": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date" },
        "sourceAsset": { "type": "string", "minLength": 1 },
        "promptFile": { "type": ["string", "null"] },
        "modifications": { "type": "string", "minLength": 1 },
        "licenseSpdx": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "licenseUrl": { "type": ["string", "null"], "format": "uri" },
        "redistributionAllowed": { "const": true },
        "noticeFile": { "type": "string", "minLength": 1 }
      }
    }
  }
}
