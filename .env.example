# Non-secret runtime settings
NODE_ENV=production
APP_ORIGIN=http://localhost:3000
APP_PORT=3000
AVATAR_LAB_ENABLED=false
EVENT_SLUG=frontend-chat-3rd
EVENT_TITLE=프론트엔드 단톡방 3주년
EVENT_QUESTION=지난 3년 동안 이 방에서 가장 기억에 남는 순간은 무엇인가요?
POSTGRES_DB=frontend_chat
POSTGRES_USER=frontend_chat
DATABASE_URL=postgresql://frontend_chat:change-me@db:5432/frontend_chat

# Secrets: use long, random values in production. Keep the resulting .env file
# outside version control and readable only by the deployment account.
POSTGRES_PASSWORD=change-me
AUTH_PEPPER=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
INVITE_CODE=replace-with-a-private-invite-code
ADMIN_USERNAME=host
ADMIN_PASSWORD=replace-with-at-least-15-characters

# Development-only demo data. The demo seeder refuses to run without the flag.
ALLOW_DEMO_SEED=false
DEMO_PARTICIPANT_PIN=123456

# Archive analysis only. Inject this on the Kakao archive LXC and never copy
# the value into Git, Docker images, application logs, or the event database.
# AVATAR_HASH_KEY=inject-only-on-the-archive-lxc

# Optional HTTPS proxy setting
APP_DOMAIN=localhost
